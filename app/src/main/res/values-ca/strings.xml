    <!-- DT2W Screen -->
    <string name="dt2w_desc">Desperta el dispositiu tocant dues vegades la pantalla quan estigui apagada. El Q25 no té despertar per gestos de maquinari, de manera que això executa un petit daemon en segon pla que vigila la pantalla tàctil i desperta en detectar un doble toc.</string>
    <string name="dt2w_state">Estat: %1$s</string>
    <string name="dt2w_on">Encès</string>
    <string name="dt2w_off">Apagat</string>
    <string name="dt2w_boot_notice"> (s’activa en el proper inici)</string>
    <string name="dt2w_enabled_label">Habilitat</string>
    <string name="dt2w_status_on">DT2W encès. Toca dues vegades la pantalla apagada per despertar.</string>
    <string name="dt2w_status_off">DT2W apagada.</string>

    <!-- PIN Keyboard Screen -->
    <string name="pin_desc">Escriu el PIN de la pantalla de bloqueig al teclat físic. Els números s’assignen a l’estil de marcatge telefònic: W E R = 1 2 3, S D F = 4 5 6, Z X C = 7 8 9, Q = 0. Enter confirma, Backspace esborra. No requereix root - només utilitza el servei d’accessibilitat.</string>
    <string name="generic_enabled">Habilitat</string>

    <!-- Accessibility Service Banner -->
    <string name="a11y_banner_enabled">Servei d’accessibilitat: habilitat</string>
    <string name="a11y_banner_needed">Aquesta funció requereix habilitar el servei d’accessibilitat.</string>
    <string name="a11y_banner_btn">Obrir Ajustos d’Accessibilitat</string>

    <!-- Key Remap Screen -->
    <string name="key_remap_desc">Onderschept o intercepta una tecla física lliure al controlador de maquinari i la reassigna a Ctrl Dret. Com que funciona a nivell de distribució d’entrada del sistema operatiu, funciona a tot arreu (emuladors de terminal, clients SSH, jocs i editors de text). Torna a carregar el controlador del teclat en aplicar perquè tingui efecte immediat.</string>
    <string name="key_remap_source_title">Tecla origen</string>
    <string name="key_remap_currency_label">Tecla de moneda</string>
    <string name="key_remap_currency_desc">La tecla € / £ / $ al costat d’Espai. El microprogramari la mapeja incorrectament com a accent greu — reassignar-la a Ctrl no afecta l’escriptura normal.</string>
    <string name="key_remap_rshift_label">Shift Dret</string>
    <string name="key_remap_rshift_desc">La tecla Shift dreta. Shift Esquerre segueix funcionant amb normalitat per a les majúscules.</string>
    <string name="key_remap_enabled_label">Habilitat</string>
    <!-- Auto Focus Screen -->
    <string name="title_auto_focus">Enfocament automàtic d’entrada</string>
    <string name="subtitle_auto_focus">Enfoca el primer camp després d’una tecla</string>
    <string name="auto_focus_enabled_switch">Habilitar enfocament automàtic</string>
    <string name="auto_focus_search_label">Buscar aplicacions</string>
    <string name="auto_focus_selected_count">%1$d seleccionades de %2$d aplicacions</string>
    <string name="auto_focus_long_desc">En les aplicacions seleccionades, el servei d’accessibilitat busca el primer camp de text editable després de la primera pulsació d’una tecla física, l’enfoca i torna a enviar aquesta tecla perquè puguis continuar escrivint sense tocar abans el camp (per exemple, en marcadors telefònics o aplicacions de missatgeria).</string>
    <!-- In-Call Shortcuts Screen -->
    <string name="title_in_call_shortcuts">Dreceres en trucada</string>
    <string name="subtitle_in_call_shortcuts">Alterna silenci, altaveu i teclat en trucades</string>
    <string name="in_call_shortcuts_desc">A la pantalla de trucada de l’aplicació Telèfon de Google, utilitzeu M per silenciar/activar el micròfon, $ per alternar l’altaveu i 0–9 per obrir el teclat de marcatge. No requereix root.</string>
    <string name="in_call_shortcuts_enabled_label">Habilitat</string>
