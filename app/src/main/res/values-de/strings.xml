    <!-- DT2W Screen -->
    <string name="dt2w_desc">Wecken Sie das Gerät durch Doppeltippen auf den Bildschirm auf, wenn er ausgeschaltet ist. Das Q25 verfügt über keine Hardware-Gestenaktivierung, daher läuft ein kleiner Hintergrund-Wächter, der den Touchscreen überwacht und bei einem Doppeltippen ein Aufweck-Event sendet.</string>
    <string name="dt2w_state">Status: %1$s</string>
    <string name="dt2w_on">Ein</string>
    <string name="dt2w_off">Aus</string>
    <string name="dt2w_boot_notice"> (aktiviert beim nächsten Systemstart)</string>
    <string name="dt2w_enabled_label">Aktiviert</string>
    <string name="dt2w_status_on">DT2W aktiv. Doppeltippen Sie auf den ausgeschalteten Bildschirm, um das Gerät aufzuwecken.</string>
    <string name="dt2w_status_off">DT2W deaktiviert.</string>

    <!-- PIN Keyboard Screen -->
    <string name="pin_desc">Geben Sie Ihre Sperrbildschirm-PIN über die physische Tastatur ein. Die Zahlen sind im Stil eines Telefontastenfelds angeordnet: W E R = 1 2 3, S D F = 4 5 6, Z X C = 7 8 9, Q = 0. Eingabe bestätigt, Rückschritttaste löscht. Kein Root erforderlich - nutzt ausschließlich den Barrierefreiheitsdienst.</string>
    <string name="generic_enabled">Aktiviert</string>

    <!-- Accessibility Service Banner -->
    <string name="a11y_banner_enabled">Barrierefreiheitsdienst: aktiviert</string>
    <string name="a11y_banner_needed">Diese Funktion erfordert die Aktivierung des Barrierefreiheitsdienstes.</string>
    <string name="a11y_banner_btn">Barrierefreiheitseinstellungen öffnen</string>

    <!-- Key Remap Screen -->
    <string name="key_remap_desc">Fängt eine freie physische Taste auf Treiber-Ebene ab und ordnet sie der rechten Strg-Taste zu. Da dies direkt in der Betriebssystem-Eingabelayout-Ebene läuft, funktioniert es überall — einschließlich Terminal-Emulatoren, SSH-Clients, Spielen und Editoren. Lädt den Tastaturtreiber bei der Anwendung neu, damit Änderungen sofort wirksam werden.</string>
    <string name="key_remap_source_title">Ausgangstaste</string>
    <string name="key_remap_currency_label">Währungstaste</string>
    <string name="key_remap_currency_desc">Die € / £ / $-Taste neben der Leertaste. Die Firmware belegt diese fälschlicherweise als Backtick/Gravis-Zeichen — die Neubelegung als Strg beeinträchtigt das normale Schreiben nicht.</string>
    <string name="key_remap_rshift_label">Rechte Umschalttaste</string>
    <string name="key_remap_rshift_desc">Die rechte Umschalttaste. Die linke Umschalttaste funktioniert weiterhin normal zur Großschreibung.</string>
    <string name="key_remap_enabled_label">Aktiviert</string>
    <!-- Auto Focus Screen -->
    <string name="title_auto_focus">Automatischer Eingabefokus</string>
    <string name="subtitle_auto_focus">Erstes Textfeld beim Laden fokussieren</string>
    <string name="auto_focus_enabled_switch">Automatischen Fokus aktivieren</string>
    <string name="auto_focus_search_label">Apps suchen</string>
    <string name="auto_focus_selected_count">%1$d ausgewählt von %2$d Apps</string>
    <string name="auto_focus_long_desc">In den ausgewählten Apps sucht der Barrierefreiheitsdienst beim Laden des Bildschirms automatisch nach dem ersten bearbeitbaren Texteingabefeld und fokussiert dieses. So können Sie sofort auf der physischen Tastatur zu tippen beginnen, ohne das Feld vorher antippen zu müssen (z. B. in Telefon- oder Messenger-Apps).</string>
    <!-- In-Call Shortcuts Screen -->
    <string name="title_in_call_shortcuts">Tastenkombinationen im Telefonat</string>
    <string name="subtitle_in_call_shortcuts">Stummschaltung, Lautsprecher und Tastatur in Anrufen umschalten</string>
    <string name="in_call_shortcuts_desc">Verwenden Sie im Anruferbildschirm der Google Telefon-App Alt+M zum Stummschalten/Aktivieren, Alt+S zum Ein-/Ausschalten des Lautsprechers und Alt+K zum Ein-/Ausblenden der Wähltastatur. Kein Root erforderlich.</string>
    <string name="in_call_shortcuts_enabled_label">Aktiviert</string>
</resources>
