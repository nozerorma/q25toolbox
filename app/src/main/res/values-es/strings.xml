    <!-- DT2W Screen -->
    <string name="dt2w_desc">Despierta el dispositivo tocando dos veces la pantalla cuando esté apagada. El Q25 no tiene despertar por gestos de hardware, por lo que esto ejecuta un pequeño daemon en segundo plano que vigila el panel táctil e inyecta un evento de encendido al detectar un doble toque.</string>
    <string name="dt2w_state">Estado: %1$s</string>
    <string name="dt2w_on">Encendido</string>
    <string name="dt2w_off">Apagado</string>
    <string name="dt2w_boot_notice"> (se activa en el próximo inicio)</string>
    <string name="dt2w_enabled_label">Habilitado</string>
    <string name="dt2w_status_on">DT2W encendido. Toca dos veces la pantalla apagada para despertar.</string>
    <string name="dt2w_status_off">DT2W apagado.</string>

    <!-- PIN Keyboard Screen -->
    <string name="pin_desc">Escribe el PIN de tu pantalla de bloqueo en el teclado físico. Los números se asignan al estilo de marcación telefónica: W E R = 1 2 3, S D F = 4 5 6, Z X C = 7 8 9, Q = 0. Enter confirma, Backspace borra. No requiere root - solo usa el servicio de accesibilidad.</string>
    <string name="generic_enabled">Habilitado</string>

    <!-- Accessibility Service Banner -->
    <string name="a11y_banner_enabled">Servicio de accesibilidad: habilitado</string>
    <string name="a11y_banner_needed">Esta función requiere habilitar el servicio de accesibilidad.</string>
    <string name="a11y_banner_btn">Abrir Ajustes de Accesibilidad</string>

    <!-- Key Remap Screen -->
    <string name="key_remap_desc">Onderschept o intercepta una tecla física libre en el stuurprogramma/controlador de hardware y la reasigna a Ctrl Derecho. Al ejecutarse a nivel de distribución de entrada del sistema operativo, funciona en todas partes (emuladores de terminal, clientes SSH, juegos y editores de texto). Vuelve a cargar el stuurprogramma del teclado al aplicar para que tenga efecto inmediato.</string>
    <string name="key_remap_source_title">Tecla origen</string>
    <string name="key_remap_currency_label">Tecla de moneda</string>
    <string name="key_remap_currency_desc">La tecla € / £ / $ al lado de Espacio. El firmware la mapea incorrectamente como acento grave — reasignarla a Ctrl no afecta a la escritura normal.</string>
    <string name="key_remap_rshift_label">Shift Derecho</string>
    <string name="key_remap_rshift_desc">La tecla Shift derecha. Shift Izquierdo sigue funcionando con normalidad para las mayúsculas.</string>
    <string name="key_remap_enabled_label">Habilitado</string>
    <!-- Auto Focus Screen -->
    <string name="title_auto_focus">Enfoque automático de entrada</string>
    <string name="subtitle_auto_focus">Enfoca el primer campo de texto al cargar</string>
    <string name="auto_focus_enabled_switch">Habilitar enfoque automático</string>
    <string name="auto_focus_search_label">Buscar aplicaciones</string>
    <string name="auto_focus_selected_count">%1$d seleccionadas de %2$d aplicaciones</string>
    <string name="auto_focus_long_desc">En las aplicaciones seleccionadas, el servicio de accesibilidad busca automáticamente el primer campo de entrada de texto editable cuando se carga la pantalla y lo enfoca. Esto le permite comenzar a escribir en el teclado físico inmediatamente sin tener que tocar el campo primero (por ejemplo, en marcadores telefónicos o aplicaciones de mensajería).</string>
    <!-- In-Call Shortcuts Screen -->
    <string name="title_in_call_shortcuts">Atajos en llamada</string>
    <string name="subtitle_in_call_shortcuts">Alterna silencio, altavoz y teclado en llamadas</string>
    <string name="in_call_shortcuts_desc">En la pantalla de llamada de la aplicación Teléfono de Google, use Alt+M para silenciar/activar el micrófono, Alt+S para alternar el altavoz y Alt+K para mostrar/ocultar el teclado de marcación. No requiere root.</string>
    <string name="in_call_shortcuts_enabled_label">Habilitado</string>
