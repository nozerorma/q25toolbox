    <string name="extra_dim_intensity_status">Dimming intensity set to %1$d%%</string>
    <string name="extra_dim_auto_night">Auto Night Dim</string>
    <string name="extra_dim_schedule_desc">Automatically turns Extra Dim on at the start time and off at the end time every day, without needing the app open.</string>
    <string name="extra_dim_schedule_state">Schedule: %1$s</string>
    <string name="extra_dim_schedule_on">On</string>
