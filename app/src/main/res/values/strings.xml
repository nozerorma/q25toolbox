    <string name="besloudness_on_status">BesLoudness enabled.</string>
    <string name="besloudness_off_status">BesLoudness disabled.</string>
    <string name="besloudness_auto_schedule">Auto Schedule</string>
    <string name="besloudness_schedule_desc">Automatically turns BesLoudness on at the start time and off at the end time every day, without needing the app open.</string>
