    <string name="location_idle_enabled_label">Enabled</string>
    <string name="location_idle_turn_off_after">Turn off after</string>
    <string name="location_idle_minutes">%1$d min</string>
    <string name="location_idle_hours">%1$d h</string>
    <string name="location_idle_status_on">Location will turn off after %1$d min with no active GPS fix.</string>
    <string name="location_idle_status_off">Auto-disable off. Location stays as you set it.</string>
    <string name="location_idle_desc">Turns Location off after a period with no active GPS fix (navigation, ride-hailing pickup, camera geotag, ...). Background low-power location checks from Google Play services don\'t count as "active" and won\'t keep resetting the timer.</string>

    <!-- Global Telemetry Block Screen -->
    <string name="telemetry_protection_status">Protection Status</string>
    <string name="telemetry_status_full">Status: Fully Protected</string>
    <string name="telemetry_status_partial">Status: Partially Protected</string>
    <string name="telemetry_status_none">Status: Unprotected</string>
    <string name="telemetry_detected_apps">Detected apps with telemetry: %1$d</string>
    <string name="telemetry_blocked_apps">Blocked apps: %1$d</string>
    <string name="telemetry_enable_at_boot">Enable at Boot</string>
    <string name="telemetry_autoblock_on">Auto-block enabled. Will run on every boot.</string>
    <string name="telemetry_autoblock_off">Auto-block disabled.</string>
    <string name="telemetry_block_now_button">Block all telemetry now</string>
    <string name="telemetry_show_details">Show per-app status (%1$d)</string>
    <string name="telemetry_hide_details">Hide per-app status</string>
    <string name="telemetry_surface_blocked">blocked</string>
    <string name="telemetry_surface_leaking">leaking</string>
    <string name="telemetry_block_now_status">Toggled telemetry off for all detected apps.</string>
    <string name="telemetry_desc">Globally forces off Firebase data collection system-wide — Crashlytics, Analytics / Google Analytics, and Performance Monitoring — by holding their persisted opt-out flags. A watchdog re-applies it every few minutes and after every app install, since the SDKs reset the flags on each cold start. Halts background crash-log and analytics packaging and upload, saving mobile data, RAM, and wakeups.</string>

