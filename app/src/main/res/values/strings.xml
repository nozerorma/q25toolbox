    <string name="bt_idle_status_off">Auto-disable off. Bluetooth stays as you set it.</string>
    <string name="bt_idle_desc">Turns Bluetooth off after a period with no device connected, so an idle radio can\'t hold the system awake overnight. Connecting earbuds, a watch or a speaker resets the timer.</string>

    <!-- Location Auto-Disable Screen -->
    <string name="location_idle_state">State: %1$s</string>
