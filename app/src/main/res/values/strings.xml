    <string name="besloudness_ends_at">Ends at</string>
    <string name="besloudness_desc">Toggles the vendor speaker loudness-enhancement DSP stage, the same one behind Settings\' own "Sound Enhancement" screen. Applies immediately, including to whatever\'s already playing.</string>

