    <!-- DT2W Screen -->
    <string name="dt2w_desc">Wake the device by double-tapping the screen while it\'s off. The Q25 has no hardware gesture-wake, so this runs a small background watchdog that watches the touchscreen and wakes on a double-tap.</string>
    <string name="dt2w_state">State: %1$s</string>
    <string name="dt2w_on">On</string>
    <string name="dt2w_off">Off</string>
    <string name="dt2w_boot_notice"> (starts at next boot)</string>
    <string name="dt2w_enabled_label">Enabled</string>
    <string name="dt2w_status_on">DT2W on. Double-tap the off screen to wake.</string>
    <string name="dt2w_status_off">DT2W off.</string>

    <!-- PIN Keyboard Screen -->
    <string name="pin_desc">Type your lockscreen PIN on the physical keyboard. Digits map phone-dialpad style: W E R = 1 2 3, S D F = 4 5 6, Z X C = 7 8 9, Q = 0. Enter confirms, Backspace deletes. No root needed - uses the accessibility service only.</string>
    <string name="generic_enabled">Enabled</string>

    <!-- Accessibility Service Banner -->
    <string name="a11y_banner_enabled">Accessibility service: enabled</string>
    <string name="a11y_banner_needed">This feature needs the accessibility service enabled.</string>
    <string name="a11y_banner_btn">Open Accessibility Settings</string>

    <!-- Key Remap Screen -->
    <string name="key_remap_desc">Intercepts a spare physical key at the hardware driver level and remaps it to Right Ctrl. Because this runs at the OS input layout level, it works everywhere — including terminal emulators, SSH clients, games, and text editors. Re-binds the keyboard driver on apply so changes take effect immediately.</string>
    <string name="key_remap_source_title">Source Key</string>
    <string name="key_remap_currency_label">Currency key</string>
    <string name="key_remap_currency_desc">The € / £ / $ key next to Space. Currently mismapped as backtick by the firmware — remapping it to Ctrl doesn\'t affect normal typing.</string>
    <string name="key_remap_rshift_label">Right Shift</string>
    <string name="key_remap_rshift_desc">The right-hand Shift key. Left Shift still works normally for uppercase.</string>
    <string name="key_remap_recents_label">Recents (BlackBerry key)</string>
    <string name="key_remap_recents_desc">The dedicated recent-apps/task-switcher key. Remapping it to Ctrl means you lose the hardware shortcut for recents.</string>
    <string name="key_remap_enabled_label">Enabled</string>
    <!-- Auto Focus Screen -->
    <string name="title_auto_focus">Auto-Focus Input</string>
    <string name="subtitle_auto_focus">Focus first text field after keypress</string>
    <string name="auto_focus_enabled_switch">Enable autofocus</string>
    <string name="auto_focus_search_label">Search apps</string>
    <string name="auto_focus_selected_count">%1$d selected of %2$d apps</string>
    <string name="auto_focus_long_desc">In selected apps, the accessibility service searches for the first editable text input field after your first physical keypress, focuses it, and replays that key so typing can continue without tapping the field first (e.g., in dialers or messaging apps).</string>
    <string name="auto_focus_enabled_label">Enabled</string>
    <!-- In-Call Shortcuts Screen -->
    <string name="title_in_call_shortcuts">In-Call Shortcuts</string>
    <string name="subtitle_in_call_shortcuts">Toggle mute, speaker, and keypad in calls</string>
    <string name="in_call_shortcuts_desc">On the Google Phone call screen, use M to mute/unmute, $ to toggle the speaker, and 0–9 to open the dialer keypad. No root required.</string>
    <string name="in_call_shortcuts_enabled_label">Enabled</string>

    <!-- IME Suggestions Screen -->
    <string name="ime_suggestions_desc">Press Ctrl+W, Ctrl+E, or Ctrl+R to pick suggestion 1, 2, or 3 from the physical keyboard\'s candidate strip (BlackBerry Keyboard, Harpocrat, and similar). Only acts when a suggestion is actually showing, so Ctrl+W/E/R still behave normally elsewhere (e.g. closing a browser tab). No root required.</string>
