    <!-- DT2W Screen -->
    <string name="dt2w_desc">Riattiva il dispositivo toccando due volte lo schermo quando è spento. Il Q25 non dispone di riattivazione tramite gesti hardware, quindi questo avvia un piccolo daemon in background che controlla lo schermo tattile e sveglia il dispositivo al doppio tocco.</string>
    <string name="dt2w_state">Stato: %1$s</string>
    <string name="dt2w_on">Acceso</string>
    <string name="dt2w_off">Spento</string>
    <string name="dt2w_boot_notice"> (attivo al prossimo avvio)</string>
    <string name="dt2w_enabled_label">Abilitato</string>
    <string name="dt2w_status_on">DT2W attivo. Tocca due volte lo schermo spento per svegliare.</string>
    <string name="dt2w_status_off">DT2W disattivato.</string>

    <!-- PIN Keyboard Screen -->
    <string name="pin_desc">Digita il PIN del blocco schermo sulla tastiera fisica. I numeri sono mappati in stile tastierino telefonico: W E R = 1 2 3, S D F = 4 5 6, Z X C = 7 8 9, Q = 0. Invio conferma, Cancella elimina. Nessun root richiesto - usa solo il servizio di accessibilità.</string>
    <string name="generic_enabled">Abilitato</string>

    <!-- Accessibility Service Banner -->
    <string name="a11y_banner_enabled">Servizio di accessibilità: abilitato</string>
    <string name="a11y_banner_needed">Questa funzione richiede il servizio di accessibilità abilitato.</string>
    <string name="a11y_banner_btn">Apri impostazioni di accessibilità</string>

    <!-- Key Remap Screen -->
    <string name="key_remap_desc">Intercetta un tasto fisico a livello di driver hardware e lo rimappa a Ctrl Destro. Funzionando a livello di layout di input del sistema operativo, funziona ovunque (emulatori di terminale, client SSH, giochi e editor di testo). Ricarica il driver della tastiera all\'applicazione per rendere le modifiche immediatamente attive.</string>
    <string name="key_remap_source_title">Tasto di origine</string>
    <string name="key_remap_currency_label">Tasto valuta</string>
    <string name="key_remap_currency_desc">Il tasto € / £ / $ vicino allo Spazio. Il firmware lo mappa erroneamente come accento grave — rimapparlo a Ctrl non influisce sulla digitazione normale.</string>
    <string name="key_remap_rshift_label">Shift Destro</string>
    <string name="key_remap_rshift_desc">Il tasto Shift destro. Shift Sinistro continua a funzionare normalmente per le maiuscole.</string>
    <string name="key_remap_recents_label">Recenti (tasto BlackBerry)</string>
    <string name="key_remap_recents_desc">Il tasto dedicato alle app recenti/cambio attività. Riassegnarlo a Ctrl fa perdere la scorciatoia hardware per i recenti.</string>
    <string name="key_remap_enabled_label">Abilitato</string>
    <!-- Auto Focus Screen -->
    <string name="title_auto_focus">Messa a fuoco automatica dell’input</string>
    <string name="subtitle_auto_focus">Mette a fuoco il primo campo dopo un tasto</string>
    <string name="auto_focus_enabled_switch">Abilita messa a fuoco automatica</string>
    <string name="auto_focus_search_label">Cerca applicazioni</string>
    <string name="auto_focus_selected_count">%1$d selezionate di %2$d applicazioni</string>
    <string name="auto_focus_long_desc">Nelle applicazioni selezionate, il servizio di accessibilità cerca il primo campo di testo modificabile dopo la prima pressione di un tasto fisico, lo mette a fuoco e reinvia quel tasto, così puoi continuare a digitare senza toccare prima il campo (ad esempio, in combinatori telefonici o app di messaggistica).</string>
    <!-- In-Call Shortcuts Screen -->
    <string name="title_in_call_shortcuts">Scorciatoie in chiamata</string>
    <string name="subtitle_in_call_shortcuts">Alterna silenziamento, altoparlante e tastierino in chiamata</string>
    <string name="in_call_shortcuts_desc">Nella schermata di chiamata dell\'applicazione Telefono di Google, usa M per disattivare/riattivare il microfono, $ per attivare/disattivare l\'altoparlante e 0–9 per aprire il tastierino numerico. Non richiede root.</string>
    <string name="in_call_shortcuts_enabled_label">Abilitato</string>

    <!-- IME Suggestions Screen -->
    <string name="ime_suggestions_desc">Premi Ctrl+W, Ctrl+E o Ctrl+R per scegliere il suggerimento 1, 2 o 3 dalla barra dei candidati della tastiera fisica (BlackBerry Keyboard, Harpocrat e simili). Agisce solo quando è effettivamente mostrato un suggerimento, quindi Ctrl+W/E/R continuano a funzionare normalmente altrove (ad es. per chiudere una scheda del browser). Non richiede root.</string>
</resources>
