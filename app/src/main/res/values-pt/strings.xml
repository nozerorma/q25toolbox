    <!-- DT2W Screen -->
    <string name="dt2w_desc">Desperta o dispositivo tocando duas vezes na tela quando estiver apagada. O Q25 não possui despertar por gestos de hardware, então isso executa um pequeno daemon em segundo plano que monitora a tela sensível ao toque e acorda ao detectar um toque duplo.</string>
    <string name="dt2w_state">Estado: %1$s</string>
    <string name="dt2w_on">Ligado</string>
    <string name="dt2w_off">Desligado</string>
    <string name="dt2w_boot_notice"> (ativa no próximo início)</string>
    <string name="dt2w_enabled_label">Ativado</string>
    <string name="dt2w_status_on">DT2W ativado. Toque duas vezes na tela apagada para despertar.</string>
    <string name="dt2w_status_off">DT2W desativado.</string>

    <!-- PIN Keyboard Screen -->
    <string name="pin_desc">Digite o PIN da sua tela de bloqueio no teclado físico. Os números são mapeados ao estilo de discagem telefônica: W E R = 1 2 3, S D F = 4 5 6, Z X C = 7 8 9, Q = 0. Enter confirma, Backspace apaga. Não requer root - usa apenas o serviço de acessibilidade.</string>
    <string name="generic_enabled">Ativado</string>

    <!-- Accessibility Service Banner -->
    <string name="a11y_banner_enabled">Serviço de acessibilidade: ativado</string>
    <string name="a11y_banner_needed">Este recurso requer a ativação do serviço de acessibilidade.</string>
    <string name="a11y_banner_btn">Abrir Ajustes de Acessibilidade</string>

    <!-- Key Remap Screen -->
    <string name="key_remap_desc">Intercepta uma tecla física livre no nível do driver de hardware e a remapeia para o Ctrl Direito. Como roda no nível do layout de entrada do sistema operacional, funciona em todos os lugares (emuladores de terminal, clientes SSH, jogos e editores de texto). Recarrega o driver do teclado ao aplicar para que tenha efeito imediato.</string>
    <string name="key_remap_source_title">Tecla de origem</string>
    <string name="key_remap_currency_label">Tecla de moeda</string>
    <string name="key_remap_currency_desc">A tecla € / £ / $ ao lado do Espaço. O firmware mapeia incorretamente como acento grave — remapeá-la para Ctrl não afeta a digitação normal.</string>
    <string name="key_remap_rshift_label">Shift Direito</string>
    <string name="key_remap_rshift_desc">A tecla Shift direita. O Shift Esquerdo continua funcionando normalmente para as maiúsculas.</string>
    <string name="key_remap_enabled_label">Ativado</string>
    <!-- Auto Focus Screen -->
    <string name="title_auto_focus">Foco automático de entrada</string>
    <string name="subtitle_auto_focus">Foca o primeiro campo após uma tecla</string>
    <string name="auto_focus_enabled_switch">Habilitar foco automático</string>
    <string name="auto_focus_search_label">Buscar aplicativos</string>
    <string name="auto_focus_selected_count">%1$d selecionados de %2$d aplicativos</string>
    <string name="auto_focus_long_desc">Nos aplicativos selecionados, o serviço de acessibilidade busca o primeiro campo de texto editável após a primeira tecla física pressionada, foca esse campo e reenvia essa tecla para que você possa continuar digitando sem tocar no campo antes (por exemplo, em discadores ou aplicativos de mensagens).</string>
    <!-- In-Call Shortcuts Screen -->
    <string name="title_in_call_shortcuts">Atalhos em chamada</string>
    <string name="subtitle_in_call_shortcuts">Alterna mudo, alto-falante e teclado em chamadas</string>
    <string name="in_call_shortcuts_desc">Na tela de chamada do aplicativo Telefone do Google, use M para ativar/desativar o mudo do microfone, $ para alternar o alto-falante e 0–9 para abrir o teclado numérico. Não requer root.</string>
    <string name="in_call_shortcuts_enabled_label">Ativado</string>
